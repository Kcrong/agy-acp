{
  "name": "@kcrong/agy-acp",
  "version": "0.1.0",
  "description": "ACP v1 adapter for the Google Antigravity CLI",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kcrong/agy-acp.git"
  },
  "bugs": {
    "url": "https://github.com/Kcrong/agy-acp/issues"
  },
  "homepage": "https://github.com/Kcrong/agy-acp#readme",
  "keywords": [
    "acp",
    "agent-client-protocol",
    "antigravity",
    "coding-agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.9.0 <12"
  },
  "bin": {
    "agy-acp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "check:unit": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "check": "npm run check:unit && npm run test:e2e",
    "prepack": "npm run check && node scripts/package-smoke.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
